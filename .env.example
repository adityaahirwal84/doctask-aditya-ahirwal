# Copy to .env and adjust. docker-compose.yml reads these for the
# api/worker/migrate services; nothing here is a real secret's default.

# fake = deterministic, offline, zero-cost provider (what tests/CI use).
# openai = real OpenAI-compatible provider; requires LLM_API_KEY.
LLM_PROVIDER=fake
LLM_API_KEY=

# Single shared key checked on every API request. Change this for anything
# beyond local use - see docs/architecture.md for why this is a deliberate
# cut versus full JWT/multi-tenant auth.
API_KEY=dev-local-key
